# Supabase — copy this file to `apps/web/.env` and fill in values
# Dashboard: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for Admin (People image upload + save/delete): bypasses RLS on server only.
# Dashboard → Project Settings → API → service_role (secret). Never commit to git.
# SUPABASE_SERVICE_ROLE_KEY=
